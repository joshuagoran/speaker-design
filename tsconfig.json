{
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite-plus/client"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "tests", "vite.config.ts"]
}
